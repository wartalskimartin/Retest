@using System.Text.Json
@using Microsoft.JSInterop
@using RetestWebAssembly.Services
@using SharedLib.DTO

@page "/"
@page "/index"

@inject BilboxService BilboxService
@inject FilterService FilterService
@inject IJSRuntime JSRuntime
@inject AppLogService AppLog

<DxLoadingPanel @bind-Visible="loadVisible"
                IsContentBlocked="true"
                CloseOnClick="false"
                CssClass="w-100"
                Text=@loadText
                ApplyBackgroundShading="true">

<div class="row">
        <div class="col">
            <h5>Hala</h5>
            <DxComboBox Data=@halls
                        TextChanged="OnHallSelectInputChanged"
                        @bind-Value=FilterService.SelectedHall
                        FilteringMode="DataGridFilteringMode.Contains"
                        NullText="Vyberte halu..."
                        CssClass="w-100 mb-3" />
        </div>
        <div class="col">
            <h5>Řada</h5>
            <DxComboBox Data=@rows
                        TextChanged="OnRowSelectInputChanged"
                        @bind-Value=FilterService.SelectedRow
                        FilteringMode="DataGridFilteringMode.Contains"
                        NullText="Vyberte řadu..."
                        CssClass="w-100 mb-3" />
        </div>
        <div class="col">
            <h5>Bilbox</h5>
            <DxComboBox Data=@avaibleBilboxes
                        TextChanged="OnBilboxSelectInputChanged"
                        @bind-Value=FilterService.SelectedBilbox
                        FilteringMode="DataGridFilteringMode.Contains"
                        NullText="Vyberte bilbox..."
                        CssClass="w-100 mb-3" />
        </div>
</div>






@if(bilboxInformation is not null)
{
<div class="card cw-480 p-2">
    <div class="row mb-1">
        <div class="col">
            <h6>Úsek: @bilboxInformation.Section</h6>
        </div>
        <div class="col">
            <h6>Hala: @bilboxInformation.Hall</h6>
        </div>
        <div class="col">
            <h6>Řada: @bilboxInformation.StandRow</h6>
        </div>
        <div class="col">
            <h6>Retesty: @RetestCount</h6>
        </div>
    </div>

    <label class="">
            NOK počítadlo kvality: @bilboxInformation.QualityCounter
    </label>

    <label class="">
            Počet NOK vybraných k retestu: @(Grid.SelectedDataItems == null ? 0 : Grid.SelectedDataItems.Count)
    </label>
</div>
}

<DxPopup HeaderText="Chyba"
         @bind-Visible="@ErrorPopupVisible"
         BodyText=@ErrorPopupText>
</DxPopup>

<div class="grid-container">
<DxGrid @ref=Grid Data="@nokList" CssClass="mt-3"
        @bind-SelectedDataItems="SelectedNok"
        PageSize="100"
        AllowColumnReorder="false"
        ValidationEnabled="false"
        EditMode="GridEditMode.EditRow"
        KeyboardNavigationEnabled="true"
        RowClick="Grid_RowClick"
        KeyFieldName="@nameof(QualityCardBilbox.ProductionDataNokId)"
        CustomizeEditModel="Grid_CustomizeEditModel"
        EditModelSaving="Grid_EditModelSaving"
        CustomizeElement="Grid_CustomizeElement"
        LayoutAutoLoading="Grid_LayoutAutoLoading"
        LayoutAutoSaving="Grid_LayoutAutoSaving"
        SizeMode="SizeMode.Large"
                AllowSort="false">
    <ToolbarTemplate>
        <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
            <DxToolbarItem Context="cc" Text="" RenderStyle="ButtonRenderStyle.None" RenderStyleMode="ToolbarItemRenderStyleMode.Plain">
                <div style="width:100px;"></div>
            </DxToolbarItem>
            <DxToolbarItem Context="cc" Text="Retest" Click="Save_Click" RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ToolbarItemRenderStyleMode.Contained">
                    @cc.Text<span class="badge rounded-pill bg-secondary ms-1">@(Grid.SelectedDataItems == null ? 0 : Grid.SelectedDataItems.Count)</span>
            </DxToolbarItem>
            <DxToolbarItem Text="Načíst znovu" Click="@(async() => await OnBilboxSelectInputChanged(FilterService.SelectedBilbox))" Enabled=@(!string.IsNullOrEmpty(FilterService.SelectedBilbox)) RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ToolbarItemRenderStyleMode.Contained" />
            <DxToolbarItem Text="Vybrat sloupce" Click="ColumnChooserButton_Click" BeginGroup="true" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ToolbarItemRenderStyleMode.Contained" />

            <DxToolbarItem Context="cc" Text="Retest" RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ToolbarItemRenderStyleMode.Plain">
                <DxCheckBox @bind-Checked="@DelayedRetest">Začít Retest po dokončení kusu</DxCheckBox>
            </DxToolbarItem>
        </DxToolbar>
    </ToolbarTemplate>
    <Columns>
        <DxGridSelectionColumn Width="100px" ShowInColumnChooser="false">
            <HeaderTemplate>
                <DxCheckBox @bind-Checked="@AllSelected"></DxCheckBox>
            </HeaderTemplate>
            <CellDisplayTemplate>
                @{
                    var qualityCardBilbox = context.DataItem as QualityCardBilbox;
                    if(qualityCardBilbox is null)
                    {
                        qualityCardBilbox = new QualityCardBilbox(){ IsFromPreviousShift = true };
                    }
                }
                <DxCheckBox Enabled=@(!(qualityCardBilbox.IsFromPreviousShift || qualityCardBilbox.IsInserted)) ReadOnly=@(qualityCardBilbox.IsFromPreviousShift || qualityCardBilbox.IsInserted) CheckedExpression="@(() => context.Selected)"
                        Checked="@(SelectedNok == null ? false : SelectedNok.Contains(context.DataItem))" CheckedChanged="@((bool value) => OnCheckedChanged(value, qualityCardBilbox))" />
            </CellDisplayTemplate>
        </DxGridSelectionColumn>
        <DxGridDataColumn FieldName="ProductNumber" Caption="Svazek" DataRowEditorVisible=false Width="130" />
        <DxGridDataColumn FieldName="OperationNumber" Caption="Operace" DataRowEditorVisible=false Width="90" />
        <DxGridDataColumn FieldName="OrderNumber" Caption="Zakazka" DataRowEditorVisible=false DisplayFormat="######" Width="100" />
        <DxGridDataColumn FieldName="OperatorNumber" Caption="Operator" DataRowEditorVisible=false DisplayFormat="##" Width="100" />
        <DxGridDataColumn FieldName="NokDateTime" Caption="Datum" DisplayFormat="dd.MM.yyyy HH:mm:ss"  DataRowEditorVisible=false Width="190" />
        <DxGridDataColumn FieldName="DeviceNumber" Caption="Device" DataRowEditorVisible=false Width="130" />
        <DxGridDataColumn FieldName="WorkingPlaceNumber" Caption="Stojan" DataRowEditorVisible=false Width="100" />
        <DxGridDataColumn FieldName="BilboxNumber" Caption="BbxNum" DataRowEditorVisible=false Width="120" />
        
        <DxGridDataColumn FieldName="Komponent" Caption="Komponent" MinWidth="150" ShowInColumnChooser="false">
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                }
                @if (!qualityCardBilbox.IsFromPreviousShift)
                {
                    <DxComboBox Data="@komponentVady"
                                NullText="Vyberte komponent..."
                                DropDownVisible="true"
                                TextFieldName="@nameof(RetestKomponentVadyDTO.KomponentName)"
                                ValueFieldName="@nameof(RetestKomponentVadyDTO.KomponentName)"
                                SelectedItemChanged="@((RetestKomponentVadyDTO? komponent) => SelectedKomponentItemChanged(komponent, qualityCardBilbox))"
                                @bind-Value="@qualityCardBilbox.Komponent">
                    </DxComboBox>
                }
            </CellEditTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="Vada" Caption="Vada" MinWidth="150" ShowInColumnChooser="false">
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                    var vadyProKomponent = GetVadyForKomponent(qualityCardBilbox.Komponent);
                }
                @if (!qualityCardBilbox.IsFromPreviousShift)
                {
                    <DxComboBox Data="@vadyProKomponent"
                                NullText="Vyberte vadu..."
                                DropDownVisible="true"
                                TextFieldName="@nameof(RetestVadaDTO.VadaName)"
                                ValueFieldName="@nameof(RetestVadaDTO.VadaName)"
                                @bind-Value="@qualityCardBilbox.Vada"
                                Enabled="@(!string.IsNullOrEmpty(qualityCardBilbox.Komponent))"
                                SelectedItemChanged="@((RetestVadaDTO? vada) => SelectedVadaItemChanged(vada, qualityCardBilbox))" />
                }
            </CellEditTemplate>
        </DxGridDataColumn>


        <DxGridDataColumn FieldName="DefectDescription" Caption="Podrobný popis vady" MinWidth="200"  ShowInColumnChooser=false >
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                }
                @if (!qualityCardBilbox.IsFromPreviousShift){
                <DxMemo CssClass="cw-480"
                        Rows="5"
                        NullText="Popis vady..."
                        @bind-Text=@qualityCardBilbox.DefectDescription oninput="@((ChangeEventArgs e) => HandleMemoInputChange(e, qualityCardBilbox))" />
                }
            </CellEditTemplate>
        </DxGridDataColumn>
        

    </Columns>
</DxGrid>
</div>
</DxLoadingPanel>


@code {
    const string SelectedAllBoxes = "VŠE";
    const string LocalStorageKey = "Grid-LayoutPersistence-Data";
    bool PreRendered { get; set; }

    bool ErrorPopupVisible { get; set; } = false;
    string ErrorPopupText { get; set; } = String.Empty;

    private async Task OnHallSelectInputChanged(string selectedHall)
    {
        await AppLog.InfoAsync("RetestPage hall selected", new() { ["hall"] = selectedHall });

        try
        {
            FilterService.SelectedRow = String.Empty;
            FilterService.SelectedBilbox = String.Empty;

            if (selectedHall == SelectedAllBoxes)
            {
                rows = await BilboxService.GetRows();
            }
            else
            {
                rows = await BilboxService.GetRows(selectedHall);
            }
            rows.Insert(0, SelectedAllBoxes);

            await AppLog.InfoAsync($"Hall selected: {selectedHall}");
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("RetestPage hall loading failed", ex, new()
            {
                ["hall"] = selectedHall,
                ["rowsCount"] = rows.Count.ToString()
            });
        }
    }

    private async Task OnRowSelectInputChanged(string selectedRow)
    {
        await AppLog.InfoAsync("RetestPage row selected", new()
        {
            ["hall"] = FilterService.SelectedHall ?? string.Empty,
            ["row"] = selectedRow
        });

        try
        {
            FilterService.SelectedBilbox = String.Empty;
            if (selectedRow == SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxes();
            }
            else if (selectedRow == SelectedAllBoxes && FilterService.SelectedHall != SelectedAllBoxes)
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall);
            }
            else if (selectedRow != SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxesByRow(selectedRow);
            }
            else
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall, selectedRow);
            }

            await AppLog.InfoAsync("RetestPage bilboxes loaded", new()
            {
                ["hall"] = FilterService.SelectedHall ?? string.Empty,
                ["row"] = selectedRow,
                ["bilboxesCount"] = avaibleBilboxes.Count.ToString()
            });
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("RetestPage row loading failed", ex, new()
            {
                ["hall"] = FilterService.SelectedHall ?? string.Empty,
                ["row"] = selectedRow
            });
        }
    }

    private async Task OnBilboxSelectInputChanged(string selectedBilbox)
    {
        try
        {
            await AppLog.InfoAsync("RetestPage Bilbox loading started", new() { ["bilbox"] = selectedBilbox });

            await RunWithBlockedUiAsync("Načítání", async () =>
            {
                bilboxInformation = await BilboxService.GetBilboxDetail(selectedBilbox);
                RetestCount = await BilboxService.GetStandRetest(FilterService.SelectedBilbox);
                await ClearUnsavedChangesAsync();
            });

            await AppLog.InfoAsync("RetestPage Bilbox loading finished", new() { ["bilbox"] = selectedBilbox });
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("RetestPage Bilbox loading failed", ex, new() { ["bilbox"] = selectedBilbox });

            ErrorPopupText = "Načítání selhalo. Zkontrolujte připojení a zkuste to znovu.";
            ErrorPopupVisible = true;
        }
    }

    bool loadVisible = false;
    string loadText = "Načítání";

    bool DelayedRetest { get; set; }

    List<string> halls = new List<string>();

    List<string> rows = new List<string>();

    List<RetestKomponentVadyDTO> komponentVady = new();

    StandsList? bilboxInformation { get; set; }
    int RetestCount { get; set; }

    IGrid Grid { get; set; }
    List<string> avaibleBilboxes = new List<string>();
    IList<QualityCardBilbox>? nokList = new List<QualityCardBilbox>();
    Dictionary<QualityCardBilbox, DataChange> UnsavedChanges { get; } = new();
    bool RetestEnabled => UnsavedChanges.Count > 0 || Grid.IsEditing();

    IReadOnlyList<object> SelectedNok { get; set; }

    bool allSelected = false;
    bool AllSelected
    {
        get { return allSelected; }
        set
        {
            allSelected = value;
            if (allSelected)
            {
                foreach (QualityCardBilbox qcb in nokList)
                {
                    Grid.SelectDataItem(qcb, !qcb.IsFromPreviousShift);
                }
            }
            else
                Grid.ClearSelection();
        }
    }

    //private readonly string ApiAddress = "http://localhost:5047/";
    private readonly string ApiAddress = "https://czvrsrvweb01.intranet.zkw.at:8965/";
    //private readonly string ApiAddressNoSsl = "http://10.13.0.19:8964/";
    //private readonly string ApiAddress = "https://czvrsrvweb01.intranet.zkw.at:8993/";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AppLog.InfoAsync("RetestPage initialization started");

            DelayedRetest = true;
            halls = await BilboxService.GetHalls();
            halls.Insert(0, SelectedAllBoxes);
            
            komponentVady = await BilboxService.GetKomponentVady();

            await AppLog.InfoAsync("RetestPage lookup data loaded", new()
            {
                ["hallsCount"] = halls.Count.ToString(),
                ["komponentCount"] = komponentVady.Count.ToString()
            });

            await base.OnInitializedAsync();

            if (FilterService.SelectedBilbox != null)
            {
                bilboxInformation = await BilboxService.GetBilboxDetail(FilterService.SelectedBilbox);
                await ClearUnsavedChangesAsync();
            }

            //load filter data after redirection; rows
            if (!string.IsNullOrEmpty(FilterService.SelectedHall))
            {
                if (FilterService.SelectedHall == SelectedAllBoxes)
                {
                    rows = await BilboxService.GetRows();
                }
                else
                {
                    rows = await BilboxService.GetRows(FilterService.SelectedHall);
                }
                rows.Insert(0, SelectedAllBoxes);
            }
            //bilboxes
            if (!string.IsNullOrEmpty(FilterService.SelectedRow))
            {
                if (FilterService.SelectedRow == SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxes();
                }
                else if (FilterService.SelectedRow == SelectedAllBoxes && FilterService.SelectedHall != SelectedAllBoxes)
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall);
                }
                else if (FilterService.SelectedRow != SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxesByRow(FilterService.SelectedRow);
                }
                else
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall, FilterService.SelectedRow);
                }
            }

            await AppLog.InfoAsync("RetestPage initialization finished", new()
            {
                ["rowsCount"] = rows.Count.ToString(),
                ["bilboxesCount"] = avaibleBilboxes.Count.ToString()
            });
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd initialization failed", ex);
        }
    }



    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            PreRendered = true;
            StateHasChanged();
        }
    }

    //check if row is not from previous shift
    void OnCheckedChanged(bool isSelected, QualityCardBilbox item)
    {
        if(!item.IsFromPreviousShift)
            Grid.SelectDataItem(item, isSelected);
    }

    void ColumnChooserButton_Click()
    {
        Grid.ShowColumnChooser();
    }

    #region GridLayoutStateSaving

    async Task Grid_LayoutAutoLoading(GridPersistentLayoutEventArgs e)
    {
        e.Layout = await LoadLayoutFromLocalStorageAsync();
    }
    async Task Grid_LayoutAutoSaving(GridPersistentLayoutEventArgs e)
    {
        await SaveLayoutToLocalStorageAsync(e.Layout);
    }
    // Refer to https://docs.microsoft.com/en-us/aspnet/core/blazor/state-management
    // to learn more about Blazor state management
    // In Blazor Server apps, prefer ASP.NET Core Protected Browser Storage
    async Task<GridPersistentLayout> LoadLayoutFromLocalStorageAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", LocalStorageKey);
            return JsonSerializer.Deserialize<GridPersistentLayout>(json);
        }
        catch
        {
            // Mute exceptions for the server prerender stage
            return null;
        }
    }
    async Task SaveLayoutToLocalStorageAsync(GridPersistentLayout layout)
    {
        try
        {
            var json = JsonSerializer.Serialize(layout);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, json);
        }
        catch
        {
            // Mute exceptions for the server prerender stage
        }
    }
    #endregion


    private async Task SetNormalMode()
    {
        await BilboxService.SetNormalMode(FilterService.SelectedBilbox);
    }

    private void HandleMemoInputChange(ChangeEventArgs e, QualityCardBilbox qualityCardBilbox)
    {
        string text = e.Value?.ToString() ?? string.Empty;
        qualityCardBilbox.DefectDescription = text;

        FillDown(qualityCardBilbox, row =>
        {
            row.DefectDescription = text;
        }, nameof(QualityCardBilbox.DefectDescription));
    }

    void Grid_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        if (e.IsNew)
        {
            var qcb = (QualityCardBilbox)e.EditModel;

            if (nokList is null)
            {
                return;
            }
            // Get the latest record
            var lastNok = nokList?.OrderByDescending(n => n.NokDateTime).FirstOrDefault();

            if (lastNok != null)
            {
                qcb.ProductNumber = lastNok.ProductNumber;
                qcb.OperationNumber = lastNok.OperationNumber;
                qcb.OrderNumber = lastNok.OrderNumber;
                qcb.OperatorNumber = lastNok.OperatorNumber;
                qcb.DeviceNumber = lastNok.DeviceNumber;
                qcb.WorkingPlaceNumber = lastNok.WorkingPlaceNumber;
                qcb.BilboxNumber = lastNok.BilboxNumber;
                qcb.NokDateTime = DateTime.Now;
                qcb.DateTimeRecord = DateTime.Now;
                qcb.IsFromPreviousShift = false;
                qcb.IsInserted = true;
            }
        }
    }

    void Grid_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        var editablePD = (QualityCardBilbox)e.EditModel;
        var qualityCardBilbox = (QualityCardBilbox)e.DataItem;
        if (!e.IsNew)
        {
            var changedFields = DataUtils.ApplyModifiedFields(editablePD, qualityCardBilbox);
            if (changedFields.Count > 0)
            {
                if (UnsavedChanges.TryGetValue(qualityCardBilbox, out var changes))
                    changes.ChangedFields.UnionWith(changedFields);
                else
                    UnsavedChanges.Add(qualityCardBilbox, new(DataChangeType.Modification, changedFields));
            }
        }
        else if (e.IsNew)
        {
            if(nokList is null){ return; }
            nokList.Add(editablePD);
            UnsavedChanges[editablePD] = new(DataChangeType.Addition, new());
        }
    }

    void Grid_CustomizeElement(GridCustomizeElementEventArgs ea)
    {
        if (ea.ElementType == GridElementType.DataRow)
        {
            var qualityCardBilbox = (QualityCardBilbox)Grid.GetDataItem(ea.VisibleIndex);
            if (qualityCardBilbox is not null && qualityCardBilbox.IsFromPreviousShift)
                ea.CssClass = "highlighted-item";
        }

        if (ea.ElementType == GridElementType.DataCell)
        {
            var qualityCardBilbox = (QualityCardBilbox)Grid.GetDataItem(ea.VisibleIndex);
            if (qualityCardBilbox is not null && qualityCardBilbox.IsFromPreviousShift)
            {
                ea.CssClass = "highlighted-item-cell";
                return;
            }

            var column = (IGridDataColumn)ea.Column;
            if (qualityCardBilbox is not null && UnsavedChanges.TryGetValue(qualityCardBilbox, out var changes))
            {
                if (changes.Type == DataChangeType.Addition || changes.ChangedFields.Contains(column.FieldName))
                    ea.CssClass = "grid-modified-cell";
            }
        }
    }

    async Task Cancel_Click() => await ClearUnsavedChangesAsync();

    async Task Save_Click()
    {
        await AppLog.InfoAsync("Retest save started", new() { ["selectedCount"] = (SelectedNok?.Count ?? 0).ToString() });

        // 1) commit aktuálně editovaného řádku
        await Grid.SaveChangesAsync();

        var selectedRows = SelectedNok?.OfType<QualityCardBilbox>().ToList() ?? new List<QualityCardBilbox>();

        // 2) validace: vybrané řádky (mimo previous shift) musí mít Komponent + Vada
        var invalidSelected = selectedRows
            .Where(x => !x.IsFromPreviousShift &&
                        (string.IsNullOrWhiteSpace(x.Komponent) || string.IsNullOrWhiteSpace(x.Vada)))
            .ToList();

        if (invalidSelected.Any())
        {
            await AppLog.InfoAsync("Retest validation failed", new() { ["invalidCount"] = invalidSelected.Count.ToString() });

            ErrorPopupText = "Vyplňte u všech vybraných kusů Komponent a Vadu.";
            ErrorPopupVisible = true;
            StateHasChanged();
            return;
        }

        List<QualityCardBilbox> result = new();
        List<QualityCardBilbox> selectedNokL = new();

        // 3) data pro save
        foreach (var nk in nokList)
        {
            nk.DateTimeRecord = DateTime.Now;

            if (nk.IsFromPreviousShift)
            {
                nk.Komponent = "ps";
                nk.Vada = "prev_shift";
                result.Add(nk);
                continue;
            }

            if (!string.IsNullOrWhiteSpace(nk.Komponent) && !string.IsNullOrWhiteSpace(nk.Vada))
                result.Add(nk);
        }

        // 4) selected list bez reference porovnávání přes Contains(result)
        selectedNokL = selectedRows
            .Where(x => !x.IsFromPreviousShift)
            .ToList();

        bool retestResult = false;
        try
        {
            await RunWithBlockedUiAsync("Připojování k Bilboxu", async () =>
            {
                retestResult = await BilboxService.SetRetestMode(
                    FilterService.SelectedBilbox,
                    result,
                    selectedNokL,
                    DelayedRetest);
            });
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("Retest save exception", ex, new() { ["bilbox"] = FilterService.SelectedBilbox ?? string.Empty });
            Console.WriteLine($"Unexpected error: {ex.Message}");
            retestResult = false;
        }

        if (retestResult)
        {
            await AppLog.InfoAsync("Retest save success", new() { ["bilbox"] = FilterService.SelectedBilbox ?? string.Empty });
            await ClearUnsavedChangesAsync();
        }
        else
        {
            await AppLog.InfoAsync("Retest save failed", new() { ["bilbox"] = FilterService.SelectedBilbox ?? string.Empty });

            ErrorPopupText = "Nedostupný Bilbox.";
            ErrorPopupVisible = true;
        }
    }

    private async Task RunWithBlockedUiAsync(string text, Func<Task> action)
    {
        loadText = text;
        loadVisible = true;

        try
        {
            await action();
        }
        finally
        {
            loadVisible = false;
        }
    }

    async Task ClearUnsavedChangesAsync()
    {
        UnsavedChanges.Clear();
        await Grid.DeselectAllAsync();
        await UpdateDataAsync();
    }

    async Task UpdateDataAsync()
    {
        var data = await BilboxService.GetNokList(FilterService.SelectedBilbox);
        nokList = new List<QualityCardBilbox>(data ?? new List<QualityCardBilbox>());
    }

    record DataChange(DataChangeType Type, HashSet<string> ChangedFields);
    enum DataChangeType { Modification, Addition, Delete }

    async Task CancelNewRow()
    {
        await Grid.CancelEditAsync();
    }

    private List<RetestVadaDTO> GetVadyForKomponent(string? komponentName)
    {
        if (string.IsNullOrWhiteSpace(komponentName))
        {
            return new List<RetestVadaDTO>();
        }

        return komponentVady
            .FirstOrDefault(k => k.KomponentName == komponentName)?
            .Vady ?? new List<RetestVadaDTO>();
    }

    void SelectedKomponentItemChanged(RetestKomponentVadyDTO? komponent, QualityCardBilbox qualityCardBilbox)
    {
        qualityCardBilbox.Komponent = komponent?.KomponentName ?? string.Empty;

        var vady = GetVadyForKomponent(qualityCardBilbox.Komponent);
        if (!vady.Any(v => v.VadaName == qualityCardBilbox.Vada))
            qualityCardBilbox.Vada = string.Empty;

        FillDown(qualityCardBilbox, row =>
        {
            row.Komponent = qualityCardBilbox.Komponent;
            var rowVady = GetVadyForKomponent(row.Komponent);
            if (!rowVady.Any(v => v.VadaName == row.Vada))
                row.Vada = string.Empty;
        }, nameof(QualityCardBilbox.Komponent), nameof(QualityCardBilbox.Vada));
    }

    void SelectedVadaItemChanged(RetestVadaDTO? vada, QualityCardBilbox qualityCardBilbox)
    {
        qualityCardBilbox.Vada = vada?.VadaName ?? string.Empty;

        FillDown(qualityCardBilbox, row =>
        {
            row.Vada = qualityCardBilbox.Vada;
        }, nameof(QualityCardBilbox.Vada));
    }

    async Task Grid_RowClick(GridRowClickEventArgs e)
    {
        var item = (QualityCardBilbox?)e.Grid.GetDataItem(e.VisibleIndex);
        if (item is null || item.IsFromPreviousShift)
            return;

        await AppLog.InfoAsync("Index row edit opened", new()
        {
            ["bilbox"] = FilterService.SelectedBilbox ?? string.Empty,
            ["productionDataNokId"] = item.ProductionDataNokId?.ToString() ?? string.Empty
        });

        if (!e.Grid.IsEditingRow(e.VisibleIndex))
            await e.Grid.StartEditRowAsync(e.VisibleIndex);
    }

    private int FindStartIndex(QualityCardBilbox source)
    {
        if (nokList is null || nokList.Count == 0)
            return -1;

        if (source.ProductionDataNokId.HasValue)
        {
            var byId = nokList.ToList().FindIndex(x => x.ProductionDataNokId == source.ProductionDataNokId);
            if (byId >= 0) return byId;
        }

        return nokList.ToList().FindIndex(x =>
            x.NokDateTime == source.NokDateTime &&
            x.WorkingPlaceNumber == source.WorkingPlaceNumber);
    }

    private void FillDown(QualityCardBilbox source, Action<QualityCardBilbox> apply, params string[] changedFields)
    {
        if (nokList is null) return;

        int start = FindStartIndex(source);
        if (start < 0) return;

        for (int i = start; i < nokList.Count; i++)
        {
            var row = nokList[i];
            if (row.IsFromPreviousShift) continue;

            apply(row);

            if (UnsavedChanges.TryGetValue(row, out var changes))
                changes.ChangedFields.UnionWith(changedFields);
            else
                UnsavedChanges[row] = new(DataChangeType.Modification, changedFields.ToHashSet());
        }

        StateHasChanged();
    }
}