@using System.Text.Json;
@using Microsoft.JSInterop

@page "/"

@inject HttpClient Http
@inject IJSRuntime JSRuntime


<h1>Bilbox</h1>


<DxComboBox Data=@avaibleBilboxes
            TextChanged="OnBilboxSelectInputChanged"
            @bind-Value=SelectedBilbox
            CssClass="w-25" />


<button class="btn btn-primary" @onclick="SetRetestMode">Set Retest Mode</button>
<button class="btn btn-primary" @onclick="SetNormalMode">Set Normal Mode</button>


<DxGrid Data="@nokList" CssClass="mw-1100">
    <Columns>
        <DxGridDataColumn FieldName="ProductNumber" Caption="Svazek" />
        <DxGridDataColumn FieldName="Operation" Caption="Operace" />
        <DxGridDataColumn FieldName="OrderNumber" Caption="Zakazka" />
        <DxGridDataColumn FieldName="OperatorNumber" Caption="Operator" />
        <DxGridDataColumn FieldName="ProductionDateTime" Caption="Datum" DisplayFormat="dd.MM.yyyy HH:mm:ss" />
        <DxGridDataColumn FieldName="Device" Caption="Device" />
        <DxGridDataColumn FieldName="Loc" Caption="Loc" />
        <DxGridDataColumn FieldName="BbxNum" Caption="BbxNum" />
    </Columns>
</DxGrid>


@code {

    private async Task OnBilboxSelectInputChanged(string selectedBilbox)//onselect="OnBilboxSelecteInputSelected"   @bind="SelectedBilbox"
    {
        System.Diagnostics.Debug.WriteLine(selectedBilbox);

        if (!String.IsNullOrEmpty(selectedBilbox))
        {
            HttpResponseMessage response = await Http.GetAsync($"http://localhost:5047/api/Bilbox/GetActualShiftNOK?standLoc={selectedBilbox}");
            string content = await response.Content.ReadAsStringAsync();
            nokList = JsonSerializer.Deserialize<List<ProductionData>>(content, _jsonSerializerOptions);
        }
    }


    public string SelectedBilbox { get; set; }
    List<string> avaibleBilboxes = new List<string>();
    List<ProductionData> nokList = new List<ProductionData>();

    private readonly JsonSerializerOptions _jsonSerializerOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    protected override async Task OnInitializedAsync()
    {
        await GetAvaibleBilboxes();
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await JSRuntime.InvokeVoidAsync("sseInterop.connectSse", "http://localhost:5047/api/sse/notifyNumberOfDevicesChanged", DotNetObjectReference.Create(this));

        await base.OnParametersSetAsync();
    }

    public async Task GetAvaibleBilboxes()
    {
        HttpResponseMessage response = await Http.GetAsync("http://localhost:5047/api/sse/getAvaibleBilboxes");
        string content = await response.Content.ReadAsStringAsync();
        avaibleBilboxes = JsonSerializer.Deserialize<List<string>>(content, _jsonSerializerOptions) ?? new List<string>();
    }

    private async Task SetRetestMode()
    {
        //var json = JsonSerializer.Serialize(nokList);
        //HttpContent content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
        var response = await Http.PostAsJsonAsync($"http://localhost:5047/api/sse/retestMode/{SelectedBilbox}", nokList);

        if (response.IsSuccessStatusCode)
        {
            // Handle a successful response here
        }
        else
        {
            // Handle errors or failed response
        }
    }

    private async Task SetNormalMode()
    {
        await Http.PostAsync($"http://localhost:5047/api/sse/normalMode/{SelectedBilbox}", null);
    }

    [JSInvokable]
    public async Task HandleEventReceived(string eventData)
    {
        int serverAvaibleBilboxes = int.Parse(eventData);
        if (avaibleBilboxes.Count != serverAvaibleBilboxes)
        {
            await GetAvaibleBilboxes();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void HandleError(object error)
    {
        // Handle SSE error
        Console.WriteLine(error.ToString());
    }
}