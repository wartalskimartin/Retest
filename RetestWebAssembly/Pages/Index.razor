@using System.Text.Json;
@using Microsoft.JSInterop
@using RetestWebAssembly.Services

@page "/"

@inject BilboxService BilboxService
@inject IJSRuntime JSRuntime


<h1>Bilbox</h1>



<DxComboBox Data=@avaibleBilboxes
            TextChanged="OnBilboxSelectInputChanged"
            @bind-Value=SelectedBilbox
            CssClass="w-25 mb-3" />

<label for="seOverview" class="demo-text cw-320 mb-1">
    Počet NOK k retestu: @UnsavedChanges.Count
</label>

@if(bilboxInformation is not null)
{
<div class="row">
    <div class="col">
        <h6>Úsek</h6>
        <h6>@bilboxInformation.Section</h6>
    </div>
    <div class="col">
        <h6>Hala</h6>
        <h6>@bilboxInformation.Hall</h6>
    </div>
    <div class="col">
        <h6>Řada</h6>
        <h6>@bilboxInformation.StandRow</h6>
    </div>
</div>   
}

@*
<button class="btn btn-primary" @onclick="SetRetestMode">Set Retest Mode</button>
*@
<button class="btn btn-primary" @onclick="SetNormalMode">Set Normal Mode</button>

<div class="grid-container">
    <div class="align-self-end pl-2 pb-2">
        <DxButton Text="Upravit sloupce"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  IconCssClass="btn-column-chooser"
                  Click="ColumnChooserButton_Click" />
    </div>
<DxGrid @ref=Grid Data="@nokList" CssClass="mt-3"
        PageSize="100"
        ValidationEnabled="false"
        EditMode="GridEditMode.EditCell"
        KeyboardNavigationEnabled="true"
        CustomizeEditModel="Grid_CustomizeEditModel"
        EditModelSaving="Grid_EditModelSaving"
        CustomizeElement="Grid_CustomizeElement"
        LayoutAutoLoading="Grid_LayoutAutoLoading"
        LayoutAutoSaving="Grid_LayoutAutoSaving">
    <ToolbarTemplate>
        <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
            <DxToolbarItem Text="Retest" Click="Save_Click" IconCssClass="grid-toolbar-save" Enabled="BatchItemsEnabled" />
            <DxToolbarItem Text="Zrušit" Click="Cancel_Click" IconCssClass="grid-toolbar-cancel" Enabled="BatchItemsEnabled" BeginGroup="true" />
        </DxToolbar>
    </ToolbarTemplate>
    <Columns>
        <DxGridDataColumn FieldName="ProductNumber" Caption="Svazek" DataRowEditorVisible=false Width="130" />
        <DxGridDataColumn FieldName="OperationNumber" Caption="Operace" DataRowEditorVisible=false Width="90" />
        <DxGridDataColumn FieldName="OrderNumber" Caption="Zakazka" DataRowEditorVisible=false DisplayFormat="######" Width="100" />
        <DxGridDataColumn FieldName="OperatorNumber" Caption="Operator" DataRowEditorVisible=false DisplayFormat="##" Width="100" />
        <DxGridDataColumn FieldName="NokDateTime" Caption="Datum" DisplayFormat="dd.MM.yyyy HH:mm:ss"  DataRowEditorVisible=false Width="190" />
        <DxGridDataColumn FieldName="DeviceNumber" Caption="Device" DataRowEditorVisible=false Width="130" />
        <DxGridDataColumn FieldName="WorkingPlaceNumber" Caption="Loc" DataRowEditorVisible=false Width="100" />
        <DxGridDataColumn FieldName="BilboxNumber" Caption="BbxNum" DataRowEditorVisible=false Width="120" />
        <DxGridDataColumn FieldName="DefectCode" Caption="Kod vady" Width="100" >
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                }
                <DxComboBox Data="@defects"
                            NullText="Vyber vadu..."
                            DropDownVisible="true"
                            FilteringMode="DataGridFilteringMode.Contains"
                            TextFieldName="@nameof(QualityDefectDescriptionBilbox.DefectCode)"
                            ValueFieldName="@nameof(QualityDefectDescriptionBilbox.DefectCode)"
                            SelectedItemChanged="@((QualityDefectDescriptionBilbox defect) => SelectedDefectTypeItemChanged(defect, ref qualityCardBilbox))"
                            @bind-Value=@qualityCardBilbox.DefectCode>
                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(QualityDefectDescriptionBilbox.DefectCode)"
                                                Caption="Kod" />
                            <DxListEditorColumn FieldName="@nameof(QualityDefectDescriptionBilbox.DefectDescription)"
                                                Caption="Typ" />
                        </Columns>
                </DxComboBox>
            </CellEditTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="DefectType" Caption="Typ vady" MinWidth="200">
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                }
                <DxComboBox Data="@defects"
                            NullText="Vyber vadu..."
                            DropDownVisible="true"
                            FilteringMode="DataGridFilteringMode.Contains"
                            TextFieldName="@nameof(QualityDefectDescriptionBilbox.DefectDescription)"
                            ValueFieldName="@nameof(QualityDefectDescriptionBilbox.DefectDescription)"
                            SelectedItemChanged="@((QualityDefectDescriptionBilbox defect) => SelectedDefectTypeItemChanged(defect, ref qualityCardBilbox))"
                            @bind-Value=@qualityCardBilbox.DefectType>
                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(QualityDefectDescriptionBilbox.DefectCode)"
                                                Caption="Kod" />
                            <DxListEditorColumn FieldName="@nameof(QualityDefectDescriptionBilbox.DefectDescription)"
                                                Caption="Typ" />
                        </Columns>
                </DxComboBox>
            </CellEditTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="DefectDescription" Caption="Podrobný popis vady" MinWidth="200">
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                }
                <DxMemo CssClass="cw-480"
                        Rows="5"
                        NullText="Popis vady..."
                        @bind-Text=@qualityCardBilbox.DefectDescription />
            </CellEditTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>
</div>

@code {
    const string LocalStorageKey = "Grid-LayoutPersistence-Data";
    bool PreRendered { get; set; }


    int NumberOfNOK { get; set; }
    int maxNOK = 2;

    private async Task OnBilboxSelectInputChanged(string selectedBilbox)//onselect="OnBilboxSelecteInputSelected"   @bind="SelectedBilbox"
    {
        System.Diagnostics.Debug.WriteLine(selectedBilbox);

        bilboxInformation = await BilboxService.GetBilboxDetail(selectedBilbox);

        if (!String.IsNullOrEmpty(selectedBilbox))
        {
            nokList = await BilboxService.GetNokList(selectedBilbox);
            if(nokList is not null)
            {
                if(nokList.Count > 0)
                {
                    maxNOK = nokList.Count;
                }
            }
        }
    }

    string SelectedBilbox { get; set; }
    StandsList? bilboxInformation { get; set; }

    IGrid Grid { get; set; }
    List<string> avaibleBilboxes = new List<string>();
    IList<QualityCardBilbox>? nokList = new List<QualityCardBilbox>();
    Dictionary<QualityCardBilbox, DataChange> UnsavedChanges { get; } = new();
    bool BatchItemsEnabled => UnsavedChanges.Count > 0 || Grid.IsEditing();

    List<QualityDefectDescriptionBilbox>? defects = new();
    string CurrentDefectCode { get; set; }
    string CurrentDefectType { get; set; }

    private readonly string ApiAddress = "http://localhost:5047/";
    private readonly string ApiAddressTest = "https://czvrsrvweb01.intranet.zkw.at:8965/";

    protected override async Task OnInitializedAsync()
    {
        await GetAvaibleBilboxes();
        defects = await BilboxService.GetDefectCodes();
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await JSRuntime.InvokeVoidAsync("sseInterop.connectSse", $"{ApiAddress}api/sse/notifyNumberOfDevicesChanged", DotNetObjectReference.Create(this));

        await base.OnParametersSetAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            PreRendered = true;
            StateHasChanged();
        }
    }

    void ColumnChooserButton_Click()
    {
        Grid.ShowColumnChooser();
    }

    #region GridLayoutStateSaving
    async Task Grid_LayoutAutoLoading(GridPersistentLayoutEventArgs e)
    {
        e.Layout = await LoadLayoutFromLocalStorageAsync();
    }
    async Task Grid_LayoutAutoSaving(GridPersistentLayoutEventArgs e)
    {
        await SaveLayoutToLocalStorageAsync(e.Layout);
    }
    // Refer to https://docs.microsoft.com/en-us/aspnet/core/blazor/state-management
    // to learn more about Blazor state management
    // In Blazor Server apps, prefer ASP.NET Core Protected Browser Storage
    async Task<GridPersistentLayout> LoadLayoutFromLocalStorageAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", LocalStorageKey);
            return JsonSerializer.Deserialize<GridPersistentLayout>(json);
        }
        catch
        {
            // Mute exceptions for the server prerender stage
            return null;
        }
    }
    async Task SaveLayoutToLocalStorageAsync(GridPersistentLayout layout)
    {
        try
        {
            var json = JsonSerializer.Serialize(layout);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, json);
        }
        catch
        {
            // Mute exceptions for the server prerender stage
        }
    }
    #endregion

    public async Task GetAvaibleBilboxes()
    {
        avaibleBilboxes = await BilboxService.GetAvaibleBilboxes();
    }

    private async Task SetRetestMode()
    {
        if (nokList is null)
        {
            return;
        }

        if (nokList.Count == 0)
        {
            return;
        }

        //transfer to ProductionDTO object and send it for retest to bilbox
        List<ProductionDataDTO> transferedNokList = new();

        foreach (QualityCardBilbox qcb in nokList)
        {
            transferedNokList.Add( new ProductionDataDTO(){
                ProductNumber = qcb.ProductNumber,
                OrderNumber = qcb.OrderNumber,
                Operation = qcb.OperationNumber,
                OperatorNumber = qcb.OperatorNumber,
                Loc = qcb.WorkingPlaceNumber,
                Device = qcb.DeviceNumber,
                TeamNumber = qcb.TeamNumber
            });
        }

        await BilboxService.SetRetestMode(SelectedBilbox, transferedNokList);
    }

    private async Task SetNormalMode()
    {
        await BilboxService.SetNormalMode(SelectedBilbox);
    }

    [JSInvokable]
    public async Task HandleEventReceived(string eventData)
    {
        int serverAvaibleBilboxes = int.Parse(eventData);
        if (avaibleBilboxes.Count != serverAvaibleBilboxes)
        {
            await GetAvaibleBilboxes();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void HandleError(object error)
    {
        // Handle SSE error
        Console.WriteLine(error.ToString());
    }

    void SelectedDefectTypeItemChanged(QualityDefectDescriptionBilbox defect, ref QualityCardBilbox qualityCardBilbox)
    {
        qualityCardBilbox.DefectCode = defect.DefectCode;
        qualityCardBilbox.DefectType = defect.DefectDescription;
    }

    void Grid_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
    }

    void Grid_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        var editablePD = (QualityCardBilbox)e.EditModel;
        var qualityCardBilbox = (QualityCardBilbox)e.DataItem;
        if (!e.IsNew)
        {
            var changedFields = DataUtils.ApplyModifiedFields(editablePD, qualityCardBilbox);
            if (changedFields.Count > 0)
            {
                if (UnsavedChanges.TryGetValue(qualityCardBilbox, out var changes))
                    changes.ChangedFields.UnionWith(changedFields);
                else
                    UnsavedChanges.Add(qualityCardBilbox, new(DataChangeType.Modification, changedFields));
            }
        }
    }

    void Grid_CustomizeElement(GridCustomizeElementEventArgs ea)
    {
        if (ea.ElementType == GridElementType.DataCell)
        {
            var qualityCardBilbox = (QualityCardBilbox)Grid.GetDataItem(ea.VisibleIndex);
            var column = (IGridDataColumn)ea.Column;
            bool isNew = qualityCardBilbox == null;
            if (!isNew && UnsavedChanges.TryGetValue(qualityCardBilbox, out var changes))
            {
                if (changes.Type == DataChangeType.Addition || changes.ChangedFields.Contains(column.FieldName))
                    ea.CssClass = "grid-modified-cell";
            }
        }
    }

    async Task Cancel_Click() => await ClearUnsavedChangesAsync();

    async Task Save_Click()
    {
        foreach (var unsavedChange in UnsavedChanges)
        {
            var dataItem = unsavedChange.Key;
            var changeType = unsavedChange.Value.Type;
            var changedFields = unsavedChange.Value.ChangedFields;
            if (changeType == DataChangeType.Modification)
            {
                await BilboxService.UpdateBilboxNokAsync(dataItem, DataUtils.GetFieldValues(dataItem, changedFields));
            }
            //break; //I think
        }
        await ClearUnsavedChangesAsync();
    }

    async Task ClearUnsavedChangesAsync()
    {
        UnsavedChanges.Clear();
        await UpdateDataAsync();
    }

    async Task UpdateDataAsync()
    {
        var data = await BilboxService.GetNokList(SelectedBilbox);
        nokList = new List<QualityCardBilbox>(data);
    }

    record DataChange(DataChangeType Type, HashSet<string> ChangedFields);
    enum DataChangeType { Modification, Addition, Delete }
}