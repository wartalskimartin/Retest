@using RetestWebAssembly.Services

@page "/manualAdd"

@inject AppLogService AppLog

@inject BilboxService BilboxService
@inject FilterService FilterService

<div class="row">
    <div class="col">
        <h5>Hala</h5>
        <DxComboBox Data=@halls
                    TextChanged="OnHallSelectInputChanged"
                    @bind-Value=FilterService.SelectedHall
                    FilteringMode="DataGridFilteringMode.Contains"
                    NullText="Vyberte halu..."
                    CssClass="w-100 mb-3" />
    </div>
    <div class="col">
        <h5>Řada</h5>
        <DxComboBox Data=@rows
                    TextChanged="OnRowSelectInputChanged"
                    @bind-Value=FilterService.SelectedRow
                    FilteringMode="DataGridFilteringMode.Contains"
                    NullText="Vyberte řadu..."
                    CssClass="w-100 mb-3" />
    </div>
    <div class="col">
        <h5>Bilbox</h5>
        <DxComboBox Data=@avaibleBilboxes
                    SelectedItemChanged="@((string bbx) => OnBilboxSelectInputChanged(bbx))"
                    @bind-Value=FilterService.SelectedBilbox
                    FilteringMode="DataGridFilteringMode.Contains"
                    NullText="Vyberte bilbox..."
                    CssClass="w-100 mb-3" />
    </div>
</div>

<DxGrid @ref="Grid"
        Data="DataSource"
        PageSize="30"
        ValidationEnabled="false"
        CustomizeEditModel="Grid_CustomizeEditModel"
        EditModelSaving="Grid_EditModelSaving"
        DataItemDeleting="Grid_DataItemDeleting"
        EditMode="GridEditMode.EditRow"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        TextWrapEnabled="true">
    <Columns>
        <DxGridDataColumn FieldName="ProductNumber" Width="210" AllowReorder="false" AllowSort="false">
            <HeaderCaptionTemplate>
                <DxButton CssClass="w-100" Enabled="@(!string.IsNullOrEmpty(FilterService.SelectedBilbox))" RenderStyle="ButtonRenderStyle.Primary" Click="@(() => Grid.StartEditNewRowAsync())" Context="hi">Přidat</DxButton>
            </HeaderCaptionTemplate>
            <CellDisplayTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.DataItem;
                }
                <button class="btn btn-link grid-btn-link" @onclick="() => DeleteGridItem(qualityCardBilbox)">Odstranit</button>
            </CellDisplayTemplate>
            <CellEditTemplate>
                <div class="row">
                    <div class="col">
                        <button class="btn btn-link grid-btn-link" @onclick="() => Grid.SaveChangesAsync()">Uložit</button>
                    </div>
                    <div class="col">
                        <button class="btn btn-link grid-btn-link" @onclick="() => Grid.CancelEditAsync()">Zrušit</button>
                    </div>
                </div>
            </CellEditTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="ProductNumber" Caption="Svazek" Width="130" />
        <DxGridDataColumn FieldName="OperationNumber" Caption="Operace" Width="90" />
        <DxGridDataColumn FieldName="OrderNumber" Caption="Zakazka" DisplayFormat="######" Width="100" />
        <DxGridDataColumn FieldName="OperatorNumber" Caption="Operator" DisplayFormat="##" Width="100" />
        <DxGridDataColumn FieldName="DatetimeServer" Caption="Datum" DisplayFormat="dd.MM.yyyy HH:mm:ss" Width="190" />
        <DxGridDataColumn FieldName="WorkingPlaceNumber" Caption="Stojan" Width="100" />
        <DxGridDataColumn FieldName="SaveCount" Caption="Počet" Width="100" />

        <DxGridDataColumn FieldName="Komponent" Caption="Komponent" Width="180" ShowInColumnChooser="false">
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                }
                <DxComboBox Data="@komponentVady"
                            NullText="Vyberte komponent..."
                            TextFieldName="@nameof(RetestKomponentVadyDTO.KomponentName)"
                            ValueFieldName="@nameof(RetestKomponentVadyDTO.KomponentName)"
                            SelectedItemChanged="@((RetestKomponentVadyDTO? komponent) => SelectedKomponentItemChanged(komponent, qualityCardBilbox))"
                            @bind-Value="@qualityCardBilbox.Komponent" />
            </CellEditTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="Vada" Caption="Vada" MinWidth="200" ShowInColumnChooser="false">
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                    var vadyProKomponent = GetVadyForKomponent(qualityCardBilbox.Komponent);
                }
                <DxComboBox Data="@vadyProKomponent"
                            NullText="Vyberte vadu..."
                            TextFieldName="@nameof(RetestVadaDTO.VadaName)"
                            ValueFieldName="@nameof(RetestVadaDTO.VadaName)"
                            SelectedItemChanged="@((RetestVadaDTO? vada) => SelectedVadaItemChanged(vada, qualityCardBilbox))"
                            @bind-Value="@qualityCardBilbox.Vada"
                            Enabled="@(!string.IsNullOrEmpty(qualityCardBilbox.Komponent))" />
            </CellEditTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="DefectDescription" Caption="Podrobný popis vady" MinWidth="200" ShowInColumnChooser=false>
            <CellEditTemplate>
                @{
                    var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
                }
                <DxMemo CssClass="cw-480"
                        Rows="5"
                        NullText="Popis vady..."
                        @bind-Text=@qualityCardBilbox.DefectDescription />
            </CellEditTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="PreviousOperation" Caption="Předch. operace" MinWidth="160" ShowInColumnChooser="false">
    <CellEditTemplate>
        @{
            var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
            var previousOperations = GetPreviousOperations(qualityCardBilbox);
        }
        <DxComboBox TData="int?" TValue="int?"
                    Data="@previousOperations"
                    NullText="Vyberte operaci..."
                    DropDownVisible="true"
                    @bind-Value="@qualityCardBilbox.PreviousOperation" />
    </CellEditTemplate>
</DxGridDataColumn>

<DxGridDataColumn FieldName="OperatorNumbers" Caption="Operátoři" MinWidth="180" ShowInColumnChooser="false">
    <CellEditTemplate>
        @{
            var qualityCardBilbox = (QualityCardBilbox)context.EditModel;
            var operatorNumbers = GetOperatorNumbers(qualityCardBilbox);
        }
        <DxComboBox TData="string" TValue="string"
                    Data="@operatorNumbers"
                    NullText="Všichni operátoři"
                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                    DropDownVisible="true"
                    @bind-Value="@qualityCardBilbox.OperatorNumbers" />
    </CellEditTemplate>
</DxGridDataColumn>
    </Columns>
</DxGrid>

@code {

    const string SelectedAllBoxes = "VŠE";

    List<string> halls = new List<string>();

    List<string> rows = new List<string>();

    List<string> avaibleBilboxes = new List<string>();

    Dictionary<(int? OrderNumber, int? OperationNumber), List<int?>> previousOperationsLookup = new();
    Dictionary<(int? OrderNumber, int? OperationNumber), List<string>> operatorNumbersLookup = new();

    private async Task OnHallSelectInputChanged(string selectedHall)
    {
        try
        {
            await AppLog.InfoAsync("ManualAdd hall selected", new() { ["hall"] = selectedHall });

            FilterService.SelectedRow = String.Empty;
            FilterService.SelectedBilbox = String.Empty;
            if (selectedHall == SelectedAllBoxes)
            {
                rows = await BilboxService.GetRows();
            }
            else
            {
                rows = await BilboxService.GetRows(selectedHall);
            }
            rows.Insert(0, SelectedAllBoxes);

            await AppLog.InfoAsync("ManualAdd rows loaded", new()
            {
                ["hall"] = selectedHall,
                ["rowsCount"] = rows.Count.ToString()
            });
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd hall selection failed", ex, new() { ["hall"] = selectedHall });
        }
    }

    private async Task OnRowSelectInputChanged(string selectedRow)
    {
        try
        {
            await AppLog.InfoAsync("ManualAdd row selected", new() { ["row"] = selectedRow });

            FilterService.SelectedBilbox = String.Empty;
            if (selectedRow == SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxes();
            }
            else if (selectedRow == SelectedAllBoxes && FilterService.SelectedHall != SelectedAllBoxes)
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall);
            }
            else if (selectedRow != SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxesByRow(selectedRow);
            }
            else
            {
                avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall, selectedRow);
            }

            await AppLog.InfoAsync("ManualAdd bilboxes loaded", new()
            {
                ["hall"] = FilterService.SelectedHall ?? string.Empty,
                ["row"] = selectedRow,
                ["bilboxesCount"] = avaibleBilboxes.Count.ToString()
            });
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd row selection failed", ex, new() { ["row"] = selectedRow });
        }
    }

    private async Task OnBilboxSelectInputChanged(string selectedBilbox)
    {
        try
        {
            await AppLog.InfoAsync("ManualAdd bilbox selected", new() { ["bilbox"] = selectedBilbox });

            DataSource = await BilboxService.GetQualityCardBilboxData(selectedBilbox);
            LastProductionData = await BilboxService.GetLastProductionData(selectedBilbox);

            previousOperationsLookup.Clear();
            operatorNumbersLookup.Clear();

            await WarmUpLookupCachesAsync(DataSource);

            if (LastProductionData is not null)
                await EnsureLookupDataAsync(LastProductionData);
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd bilbox loading failed", ex, new() { ["bilbox"] = selectedBilbox });
        }
    }

    List<RetestKomponentVadyDTO> komponentVady = new();

    IList<QualityCardBilbox> DataSource { get; set; }
    IGrid Grid { get; set; }

    //private string SelectedBilbox { get; set; } = "ST2.999";
    private QualityCardBilbox? LastProductionData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AppLog.InfoAsync("ManualAdd initialization started");

            halls = await BilboxService.GetHalls();
            halls.Insert(0, SelectedAllBoxes);

            komponentVady = await BilboxService.GetKomponentVady();

            await AppLog.InfoAsync("ManualAdd lookup data loaded", new()
            {
                ["hallsCount"] = halls.Count.ToString(),
                ["komponentCount"] = komponentVady.Count.ToString()
            });

            if (FilterService.SelectedBilbox != null)
            {
                DataSource = await BilboxService.GetQualityCardBilboxData(FilterService.SelectedBilbox);
                LastProductionData = await BilboxService.GetLastProductionData(FilterService.SelectedBilbox);

                await AppLog.InfoAsync("ManualAdd restored selected bilbox", new()
                {
                    ["bilbox"] = FilterService.SelectedBilbox
                });
            }

            //load filter data after redirection; rows
            if (!string.IsNullOrEmpty(FilterService.SelectedHall))
            {
                if (FilterService.SelectedHall == SelectedAllBoxes)
                {
                    rows = await BilboxService.GetRows();
                }
                else
                {
                    rows = await BilboxService.GetRows(FilterService.SelectedHall);
                }
                rows.Insert(0, SelectedAllBoxes);
            }
            //bilboxes
            if (!string.IsNullOrEmpty(FilterService.SelectedRow))
            {
                if (FilterService.SelectedRow == SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxes();
                }
                else if (FilterService.SelectedRow == SelectedAllBoxes && FilterService.SelectedHall != SelectedAllBoxes)
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall);
                }
                else if (FilterService.SelectedRow != SelectedAllBoxes && FilterService.SelectedHall == SelectedAllBoxes)
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxesByRow(FilterService.SelectedRow);
                }
                else
                {
                    avaibleBilboxes = await BilboxService.GetAvaibleBilboxes(FilterService.SelectedHall, FilterService.SelectedRow);
                }
            }

            await AppLog.InfoAsync("ManualAdd initialization finished", new()
            {
                ["rowsCount"] = rows.Count.ToString(),
                ["bilboxesCount"] = avaibleBilboxes.Count.ToString()
            });
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd initialization failed", ex);
        }
    }

    void Grid_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        if (e.IsNew)
        {
            var qcb = (QualityCardBilbox)e.EditModel;

            if (LastProductionData is not null)
            {
                qcb.ProductNumber = LastProductionData.ProductNumber;
                qcb.OperationNumber = LastProductionData.OperationNumber;
                qcb.OrderNumber = LastProductionData.OrderNumber;
                qcb.OperatorNumber = LastProductionData.OperatorNumber;
                qcb.DeviceNumber = LastProductionData.DeviceNumber;
                qcb.WorkingPlaceNumber = LastProductionData.WorkingPlaceNumber;
                qcb.BilboxNumber = LastProductionData.BilboxNumber;
                qcb.DateTimeRecord = DateTime.Now;
                qcb.DatetimeServer = DateTime.Now;
                qcb.SaveCount = 1;
            }
        }
    }

    async Task Grid_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        try
        {
            if (e.IsNew)
            {
                var editModel = (QualityCardBilbox)e.EditModel;

                await EnsureLookupDataAsync(editModel);
                ApplyDefaultOperatorNumbers(editModel);

                await AppLog.InfoAsync("ManualAdd inserting new row");
                await BilboxService.InsertQualityCardBilbox(editModel);
                await AppLog.InfoAsync("ManualAdd insert finished");
            }

            await UpdateDataAsync();
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd save failed", ex);
        }
    }

    async Task Grid_DataItemDeleting(GridDataItemDeletingEventArgs e)
    {
        try
        {
            await AppLog.InfoAsync("ManualAdd delete requested");

            await BilboxService.RemoveQualityCardBilbox((QualityCardBilbox)e.DataItem);
            await UpdateDataAsync();

            await AppLog.InfoAsync("ManualAdd delete finished");
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd delete failed", ex);
        }
    }

    async Task UpdateDataAsync()
    {
        DataSource = await BilboxService.GetQualityCardBilboxData(FilterService.SelectedBilbox);

        previousOperationsLookup.Clear();
        operatorNumbersLookup.Clear();

        await WarmUpLookupCachesAsync(DataSource);

        if (LastProductionData is not null)
            await EnsureLookupDataAsync(LastProductionData);
    }

    private List<RetestVadaDTO> GetVadyForKomponent(string? komponentName)
    {
        if (string.IsNullOrWhiteSpace(komponentName))
            return new List<RetestVadaDTO>();

        return komponentVady
            .FirstOrDefault(k => k.KomponentName == komponentName)?
            .Vady ?? new List<RetestVadaDTO>();
    }

    void SelectedKomponentItemChanged(RetestKomponentVadyDTO? komponent, QualityCardBilbox qualityCardBilbox)
    {
        qualityCardBilbox.Komponent = komponent?.KomponentName ?? string.Empty;

        var vady = GetVadyForKomponent(qualityCardBilbox.Komponent);
        if (!vady.Any(v => v.VadaName == qualityCardBilbox.Vada))
            qualityCardBilbox.Vada = string.Empty;
    }

    void SelectedVadaItemChanged(RetestVadaDTO? vada, QualityCardBilbox qualityCardBilbox)
    {
        qualityCardBilbox.Vada = vada?.VadaName ?? string.Empty;
    }


    public async Task CopyRowsAsync(QualityCardBilbox qcb)
    {
        try
        {
            await AppLog.InfoAsync("ManualAdd copy row requested");

            qcb.IdQualityCard = default;
            qcb.DateTimeRecord = DateTime.Now;
            qcb.DatetimeServer = DateTime.Now;

            await BilboxService.InsertQualityCardBilbox(qcb);
            await UpdateDataAsync();

            await AppLog.InfoAsync("ManualAdd copy row finished");
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd copy row failed", ex);
        }
    }

    async Task DeleteGridItem(QualityCardBilbox q)
    {
        try
        {
            await AppLog.InfoAsync("ManualAdd delete button clicked");

            await BilboxService.RemoveQualityCardBilbox(q);
            await UpdateDataAsync();

            await AppLog.InfoAsync("ManualAdd delete button finished");
        }
        catch (Exception ex)
        {
            await AppLog.ErrorAsync("ManualAdd delete button failed", ex);
        }
    }

    private static (int? OrderNumber, int? OperationNumber) GetLookupKey(QualityCardBilbox row)
        => (row.OrderNumber, row.OperationNumber);

    private async Task EnsureLookupDataAsync(QualityCardBilbox row)
    {
        if (!row.OrderNumber.HasValue || !row.OperationNumber.HasValue)
            return;

        var key = GetLookupKey(row);

        if (!previousOperationsLookup.ContainsKey(key))
        {
            previousOperationsLookup[key] = await BilboxService.GetOperationPredecessors(
                row.OrderNumber.Value,
                row.OperationNumber.Value);
        }

        if (!operatorNumbersLookup.ContainsKey(key))
        {
            operatorNumbersLookup[key] = await BilboxService.GetOperatorNumbersByOrderOperation(
                row.OrderNumber.Value,
                row.OperationNumber.Value);
        }
    }

    private async Task WarmUpLookupCachesAsync(IEnumerable<QualityCardBilbox> rows)
    {
        foreach (var row in rows)
            await EnsureLookupDataAsync(row);
    }

    private List<int?> GetPreviousOperations(QualityCardBilbox row)
    {
        return previousOperationsLookup.TryGetValue(GetLookupKey(row), out var values)
            ? values
            : new List<int?>();
    }

    private List<string> GetOperatorNumbers(QualityCardBilbox row)
    {
        return operatorNumbersLookup.TryGetValue(GetLookupKey(row), out var values)
            ? values
            : new List<string>();
    }

    private void ApplyDefaultOperatorNumbers(QualityCardBilbox row)
    {
        if (!string.IsNullOrWhiteSpace(row.OperatorNumbers))
            return;

        var operators = GetOperatorNumbers(row);
        if (operators.Count > 0)
            row.OperatorNumbers = string.Join(",", operators);
    }
}

