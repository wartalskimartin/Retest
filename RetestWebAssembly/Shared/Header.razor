@inject NavigationManager NavigationManager

<style>
    .highlight dxbl-menu-item {
        background-color: #5f368d;
        color: white;
        border-radius: 3px;
    }
</style>

<nav class="navbar header-navbar p-0">
    <DxMenu Title=""
            CollapseItemsToHamburgerMenu="false"
            CollapseItemToIconMode="MenuCollapseItemToIconMode.None"
            DisplayMode="MenuDisplayMode.Desktop"
            ItemClick="OnMenuItemClick">
        <Items>
            <DxMenuItem Name="index" Text="Retesty" IconCssClass="menu-icon-home menu-icon" CssClass="@GetClass("index")" />
            <DxMenuItem Name="manualAdd" Text="Zápis" IconCssClass="menu-icon-contacts menu-icon" CssClass="@GetClass("manualAdd")" />
        </Items>
    </DxMenu>
</nav>

@code {
    [Parameter] public bool ToggleOn { get; set; }
    [Parameter] public EventCallback<bool> ToggleOnChanged { get; set; }

    public string GetClass(string url) {
        var uri = NavigationManager.Uri;
        return uri.Contains(url, StringComparison.OrdinalIgnoreCase) ? "highlight" : string.Empty;
    }

    void OnMenuItemClick(MenuItemClickEventArgs e) {
        var target = e.ItemInfo?.Name;
        if (string.IsNullOrWhiteSpace(target))
            return;

        // keep navigation inside current Blazor base path
        NavigationManager.NavigateTo(target, forceLoad: false);
    }
}