@inject NavigationManager NavigationManager
<style>
    .highlight dxbl-menu-item {
        background-color: #5f368d;
        color: white;
        border-radius: 3px;
    }
</style>
<nav class="navbar header-navbar p-0">
    <DxMenu Title=""
            CollapseItemsToHamburgerMenu="false"
            CollapseItemToIconMode="MenuCollapseItemToIconMode.None"
            DisplayMode="MenuDisplayMode.Desktop">
        <Items>
            <DxMenuItem Text="Retesty" IconCssClass="menu-icon-home menu-icon" CssClass="@GetClass("index")" NavigateUrl="index" />
            <DxMenuItem Text="Zápis" IconCssClass="menu-icon-contacts menu-icon" CssClass="@GetClass("manualAdd")" NavigateUrl="manualAdd" />
            <DxMenuItem Text="Historie" IconCssClass="menu-icon-about menu-icon" CssClass="@GetClass("history")" NavigateUrl="history" />
        </Items>
    </DxMenu>
</nav>

@code {
    [Parameter] public bool ToggleOn { get; set; }
    [Parameter] public EventCallback<bool> ToggleOnChanged { get; set; } 
    private string currentItem { get; set; }

    public string GetClass(string url)
    {
        string className = String.Empty;
        string Uri = NavigationManager.Uri;
        if (Uri.Contains(url))
            className = "highlight";
        return className;
    }
    public void ItemClick(MenuItemClickEventArgs e)
    {
        currentItem = e.ItemInfo.NavigateUrl;
    }

    async Task OnToggleClick() => await Toggle();

    async Task Toggle(bool? value = null) {
        var newValue = value ?? !ToggleOn;
        if(ToggleOn != newValue) {
            ToggleOn = newValue;
            await ToggleOnChanged.InvokeAsync(ToggleOn);
        }
    }
}